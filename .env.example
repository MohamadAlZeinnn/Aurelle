# Public site URL — used for canonical URLs, Open Graph and structured data.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Orders & newsletter storage (Supabase) ────────────────────────────────
# When both are set, orders, newsletter sign-ups and contact messages are
# written to Supabase (see supabase/schema.sql). When missing, checkout runs
# in clearly labelled DEMO mode and nothing is recorded.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Online card payments ──────────────────────────────────────────────────
# Provider id from src/lib/payments (e.g. "areeba"). Leave empty to disable
# online payment — only methods that are configured are shown at checkout.
PAYMENT_PROVIDER=
PAYMENT_MERCHANT_ID=
PAYMENT_API_KEY=
