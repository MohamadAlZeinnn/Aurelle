# Public site URL — used for canonical URLs, Open Graph and structured data.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Newsletter & contact storage (Supabase) ──────────────────────────────
# When both are set, newsletter sign-ups and contact messages are written to
# Supabase (see supabase/schema.sql). When missing, those forms run in clearly
# labelled DEMO mode and nothing is recorded.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

