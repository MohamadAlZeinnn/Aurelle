# ─────────────────────────────────────────────────────────────
# LUMA Beauty — environment configuration
# Copy to .env.local and adjust. Never commit real secrets:
# everything prefixed with VITE_ is bundled into the public JS.
# ─────────────────────────────────────────────────────────────

# "demo"  → in-browser mock REST server persisted to localStorage (default)
# "live"  → real HTTP requests to VITE_API_BASE_URL (e.g. a .NET Web API)
VITE_API_MODE=demo

# Base URL of the production API (used only when VITE_API_MODE=live)
VITE_API_BASE_URL=https://api.example.com/api/v1

# Artificial latency (ms) for the demo server so loading states are visible
VITE_DEMO_LATENCY_MS=350

# Brand configuration
VITE_BRAND_NAME=LUMA Beauty
VITE_BRAND_SHORT_NAME=LUMA
VITE_SUPPORT_EMAIL=care@lumabeauty.example
# International format without "+" or spaces; leave empty to hide WhatsApp links
VITE_WHATSAPP_NUMBER=96170000000
VITE_INSTAGRAM_URL=https://www.instagram.com/
